# Образец. Скопируйте в tokens.env и впишите свои значения, либо, что лучше,
# заведите зашифрованное хранилище: ./set-tokens.ps1
#
# Токен выдаётся ДВУМЯ половинками: портал -> аватар -> Edit Profile -> API Tokens -> Create Token.
# Половинки местами не менять: на перестановку BookStack отвечает тем же 401, что и на чужой токен.
#
# tokens.env лежит на диске открытым текстом и внесён в .gitignore.

# Источник переноса полки (help.altway.pro)
BOOKSTACK_FROM_TOKEN_ID=
BOOKSTACK_FROM_TOKEN_SECRET=

# Приёмник: и перенос полки, и выкладка документов берут его (test.help.altway.pro)
BOOKSTACK_TO_TOKEN_ID=
BOOKSTACK_TO_TOKEN_SECRET=

# Выкладка документов сначала смотрит сюда, и только потом на BOOKSTACK_TO_*
#BOOKSTACK_TOKEN_ID=
#BOOKSTACK_TOKEN_SECRET=
